# ============================================================
# Operating system
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Editor and IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# Node.js (backend/)
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.env
.env.local
.env.*.local

# ============================================================
# Python (detector/, dataset/, experiments/, analysis/)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/

# ============================================================
# Go (chaincode/)
# ============================================================
# Binaries
*.exe
*.dll
*.so
*.dylib
# Test binary, built with `go test -c`
*.test
# Output of the go coverage tool
*.out
# Compiled chaincode binary (go build output; name derived from module path)
/chaincode/ascir/chaincode
/chaincode/ascir/ascir
# Go vendor directory (we use modules, not vendor)
vendor/

# ============================================================
# Hyperledger Fabric (network/)
# ============================================================
# Crypto materials are regenerated from configtx.yaml; never commit
crypto-config/
organizations/peerOrganizations/
organizations/ordererOrganizations/
channel-artifacts/
*.pem
*.key
# Fabric local data
fabric-ca-client-config.yaml
msp/
tls/

# ============================================================
# Experiment outputs
# ============================================================
# Raw logs are committed to experiments/results/ deliberately;
# but transient runtime logs are not
*.log
!experiments/results/*.log

# Large traces — use Git LFS if needed
*.trace
*.dump

# ============================================================
# OS- and tool-generated junk
# ============================================================
*.bak
*.tmp
*.temp
*.orig
# stray build output
/main
# figure previews (keep PDFs, ignore PNGs)
figs/*.png
